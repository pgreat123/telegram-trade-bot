# Copy this file to ".env" and fill in your real values.
# NEVER commit or share your .env file. NEVER paste your private key into chat.

# --- Telegram (get these from https://my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Comma-separated channel usernames or invite links, e.g.:
# TELEGRAM_CHANNELS=some_ca_thesis_channel,some_live_buys_channel
TELEGRAM_CHANNELS=
TELEGRAM_SESSION_NAME=trade_bot_session

# --- Robinhood Chain / wallet ---
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=
ZEROX_API_KEY=
# WETH contract on Robinhood Chain — verify yourself at
# https://docs.robinhood.com/chain/protocol-contracts before setting this.
# Do NOT trust an address from Telegram, search results, or elsewhere —
# fake WETH/USDC clones are a documented, active scam on this chain.
WETH_ADDRESS=

# --- Telegram notifier bot (optional but recommended) ---
# A SEPARATE bot account from the listener above — message @BotFather on
# Telegram, send /newbot, and paste the token it gives you here. Then send
# any message to your new bot (it can't DM you first) and run
# `python -m notifier.get_chat_id` to find TELEGRAM_CHAT_ID.
# Leave both blank to run without DM notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Safety ---
# Keep this "true" until you've watched the bot log real signals for a while.
# Set to "false" only when you're ready for it to spend real money.
DRY_RUN=true
